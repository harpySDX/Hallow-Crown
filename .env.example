# ---------------------------------------------------------------------------------------------
# Hollow Crown configuration. Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------------------------

# "supabase" (production) or "local" (embedded database + dev sign-in, for local play/testing).
# If omitted: supabase when NEXT_PUBLIC_SUPABASE_URL is set, otherwise local.
GAME_BACKEND=

# --- Supabase (required when GAME_BACKEND=supabase) -------------------------------------------
# Project Settings → API. The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Postgres connection string (Project Settings → Database → Connection string).
# On Vercel use the "Transaction pooler" URI (port 6543). Keep this secret — never NEXT_PUBLIC_.
DATABASE_URL=
# Optional: connection pool size per server instance (default 5).
DATABASE_POOL_MAX=

# --- Local mode (GAME_BACKEND=local) -----------------------------------------------------------
# Where the embedded PGlite database is stored (default .data/pglite).
LOCAL_DATA_DIR=
# Secret used to sign local-mode session cookies (any long random string).
LOCAL_AUTH_SECRET=

# --- Development -------------------------------------------------------------------------------
# 1 enables the debug overlay (hitboxes) and the localStorage "hc_debug_power" damage multiplier.
NEXT_PUBLIC_GAME_DEBUG=
# 1 exposes test hooks on window.__hc (set automatically by the Playwright config). Never in production.
NEXT_PUBLIC_E2E_HOOKS=

# ---------------------------------------------------------------- Static edition (GitHub Pages)
# STATIC_EXPORT=1 builds a plain static site in out/ where the game and its save run in the browser.
# (`npm run build:static` sets it for you; Vercel enables it automatically when DATABASE_URL is unset.)
# STATIC_EXPORT=
# The static build uses relative URLs, so it works at any path without configuration.
